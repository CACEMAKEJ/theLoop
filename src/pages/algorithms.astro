---
import MainLayout from "../layouts/MainLayout.astro";

const pageTitle = "The Loop — Ethics of Social Media Algorithms";
const description =
  "An informational website exploring how social media algorithms, doomscrolling, and FOMO affect the lives of young adults.";
---

<MainLayout title={pageTitle} description={description}>
  <section class="space-y-4">
    <h1 class="text-center text-3xl font-semibold tracking-tight">
      How the "Loop" works?
    </h1>

    <div class="py-12">
        <p class="text-slate-300">
        “The Loop” explores how social media algorithms influence the behaviour,
        mental health, and decision-making of young adults (18–25). It breaks
        down the ethics behind personalised feeds, doomscrolling, FOMO, and
        platform design choices.
        </p>
    
    </div>

   
  </section>
</MainLayout>