---
const {
  title = "The Loop",
  description = "Exploring how social media algorithms affect young adults.",
} = Astro.props;
import '../styles/global.css' 
import { initScrollEffects } from '../scripts/main';

---

<!DOCTYPE html>
<html lang="en" class="bg-slate-950 text-slate-100">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script type="module" src="/js/init.js"></script>
  </head>

  <body class="min-h-screen bg-slate-950 text-slate-100">
    <div class="flex min-h-screen flex-col">

      <!-- Navigation -->
<header id="site-header" class="sticky top-0 z-50 border-b border-slate-800 bg-slate-950/80 backdrop-blur transition-transform duration-300">
        <div class="mx-auto flex max-w-5xl items-center justify-center px-4 py-3">
          <nav class="flex gap-6 text-sm">
            <a href="/algorithms" class="hover:text-sky-400">Algorithms</a>
            <a href="/doomscrolling" class="hover:text-sky-400">Doomscrolling</a>
            <a href="/fomo" class="hover:text-sky-400">FOMO</a>
            <a href="/bigger-picture" class="hover:text-sky-400">Bigger Picture</a>
            <a href="/solutions" class="hover:text-sky-400">Solutions</a>
            <a href="/references" class="hover:text-sky-400">References</a>
          </nav>
        </div>
      </header>

      <main class="mx-auto flex w-full max-w-3xl flex-1 flex-col px-4 py-12 leading-relaxed">
        <slot />
      </main>

      <footer class="border-t border-slate-800 bg-slate-950">
        <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4 text-xs text-slate-400">
          <p>The Loop — an exploration of social media ethics and young adults.</p>
          <p>© {new Date().getFullYear()} <small>by Martin Macicha <a href="https://github.com/CACEMAKEJ">@CACEMAKEJ</a></small></p>
        </div>
      </footer>
    </div>
    <button
      id="back-to-top"
      type="button"
      class="fixed bottom-18 right-6 flex h-11 w-11 items-center justify-center rounded-full
            bg-sky-500 text-slate-950 shadow-lg shadow-sky-500/30
            transition-opacity duration-300 opacity-0 pointer-events-none
            hover:bg-sky-400 focus-visible:outline-none
            focus-visible:ring-2 focus-visible:ring-sky-400
            focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950"
      aria-label="Back to top"
    >
      <span class="text-xl leading-none">↑</span>
    </button>
  </body>
</html>
<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>


